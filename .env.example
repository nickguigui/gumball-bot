# Copie para .env (o .env NUNCA vai para o GitHub)
BOT_NAME=GUMBALL
OWNER_NAME=Nick
# Seu número, só dígitos (vira dono do bot). Vários: separe por vírgula
OWNER_NUMBERS=
# Conectar por código em vez de QR: número do bot, só dígitos
PAIR_NUMBER=
PREFIX=/
# Rodando no seu próprio número: responder também aos comandos que VOCÊ manda
ALLOW_SELF=true
# false = o bot começa DESLIGADO em cada grupo (admin liga com /bot on)
DEFAULT_BOT_ON=false
# Comandos desligados (aparecem riscados no menu)
BLOCKED_COMMANDS=face
# Anti-ban: intervalo entre envios (ms)
SEND_MIN_MS=2500
SEND_JITTER_MS=4000

# Integrações opcionais (tudo funciona sem elas, exceto o comando citado)
TMDB_API_KEY=          # /filme com pôster e /cinema (grátis em themoviedb.org)
SPICY_LYRICS_KEY=      # /lyrics fonte 1 (developers.spicylyrics.org); use a chave secreta sl_sk_ no servidor
SPICY_LYRICS_ORIGIN=   # só se usar chave pública sl_pk_: a origem liberada nela
OPENAI_API_KEY=        # /gpt melhor + /transcrever (sem chave o /gpt usa a Pollinations grátis)
TENOR_API_KEY=         # /emojimix (Google Cloud > Tenor API, grátis)
REMOVEBG_API_KEY=      # /sfundo (remove.bg, 50 grátis/mês)
# Só no GitHub Actions: chave que criptografa a sessão (gere com: node scripts/state.mjs newkey)
STATE_KEY=
